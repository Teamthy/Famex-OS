  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String   @default("Ykay EduPortal is undergoing scheduled maintenance. Please try again shortly.")
  updatedAt          DateTime @updatedAt
  updatedByUserId    String?
}

// ── Multi-tenancy (Ykay platform) ──────────────────────────────────
enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum PlanTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
