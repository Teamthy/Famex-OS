// ─────────────────────────────────────────────────────────────────────────────
//  Parent ↔ teacher messaging
//
//  Threads are always anchored to a STUDENT. That is the thing both sides
//  actually care about ("about Adeola"), it gives the permission rule a single
//  clear source of truth, and it stops the inbox becoming a flat list of names
//  with no context.
//
//  Who may participate is derived, never stored as a free-for-all:
//    parent  → must have a ParentStudentLink to the thread's student
//    teacher → must have a TeacherClassAssignment covering that student's class
//  (see lib/messaging.ts → assertThreadAccess)
// ─────────────────────────────────────────────────────────────────────────────

enum MessageThreadStatus {
  OPEN
  CLOSED
}

model MessageThread {
  id                 String              @id @default(cuid())
  schoolId           String
  studentProfileId   String
  /// Denormalised so an inbox row renders without loading the student.
  subject            String
  status             MessageThreadStatus @default(OPEN)
  /// Mirrors the newest message so the inbox can sort and preview without a join.
  lastMessageAt      DateTime            @default(now())
  lastMessagePreview String?
  createdByUserId    String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile       @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  messages       Message[]
  participants   MessageParticipant[]

  @@index([schoolId, lastMessageAt])
  @@index([studentProfileId, lastMessageAt])
}

/// One row per user who can see a thread. Carries that user's own read cursor,
/// so "unread" is per-participant rather than a single flag on the message.
model MessageParticipant {
  id         String    @id @default(cuid())
  threadId   String
  userId     String
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id           String   @id @default(cuid())
  schoolId     String
  threadId     String
  senderUserId String
  body         String
  createdAt    DateTime @default(now())

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([schoolId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Behaviour records
//
//  app/teacher/class/behavior/page.tsx held records in useState and
//  /api/teacher/class/behavior returned `records: []` with a comment naming a
//  "future BehaviorRecord model". So every note a teacher typed was lost on
//  refresh. This is that model.
//
//  Vocabulary (COMMENDATION / WARNING / NOTE) mirrors the labels the web page
//  already shows, so nothing has to be re-learned by staff.
// ─────────────────────────────────────────────────────────────────────────────

enum BehaviorRecordType {
  COMMENDATION
  WARNING
  NOTE
}

model BehaviorRecord {
  id               String             @id @default(cuid())
  schoolId         String
  studentProfileId String
  /// Author. Kept as a teacher profile so the record survives a role change.
  teacherProfileId String
  type             BehaviorRecordType
  /// Free-text bucket, e.g. "Punctuality", "Teamwork". Deliberately not an
  /// enum — schools word these differently and it is display-only.
  category         String?
  description      String
  occurredAt       DateTime           @default(now())
  /// Set when a guardian has been told, so it is auditable later.
  parentNotifiedAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId, occurredAt])
  @@index([studentProfileId, occurredAt])
  @@index([teacherProfileId, occurredAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Academic sessions, terms and enrolment history
//
//  Before this, term and session existed only as free-text strings copied onto
//  FeeInvoice, ReportCard, SubjectGradebook and Budget. Nothing defined "the
//  current term", nothing stopped "1st Term" and "First Term" becoming two
//  different terms, and StudentProfile held only currentClassId — so promoting
//  a student OVERWROTE the record of where they had been. Last session's report
//  card would then render against the student's new class.
//
//  StudentEnrolment fixes that: one row per student per session, so history
//  survives promotion. StudentProfile.currentClassId stays as a cached pointer
//  to the active enrolment — dropping it would touch dozens of queries for no
//  benefit — but the enrolment table is the source of truth.
// ─────────────────────────────────────────────────────────────────────────────

enum EnrolmentOutcome {
  IN_PROGRESS
  PROMOTED
  REPEATED
  GRADUATED
  WITHDRAWN
  TRANSFERRED
}

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  /// e.g. "2026/2027"
  label     String
  startsOn  DateTime
  endsOn    DateTime
  /// Exactly one session per school should carry this. Enforced in
  /// lib/academic-session.ts rather than by a partial index, so the same
  /// schema works on databases without them.
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms         Term[]
  enrolments    StudentEnrolment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, label])
  @@index([schoolId, isCurrent])
}

model Term {
  id        String   @id @default(cuid())
  schoolId  String
  sessionId String
  /// 1, 2 or 3. This is the SORT KEY — never parse `label` for ordering, or a
  /// school writing "1st Term" instead of "First Term" reorders its own year.
  index     Int
  label     String
  startsOn  DateTime
  endsOn    DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session       AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  invoices      FeeInvoice[]    @relation("InvoiceTerm")

  @@unique([sessionId, index])
  @@index([schoolId, isCurrent])
}

/// One row per student per session — the record that makes history durable.
model StudentEnrolment {
  id               String           @id @default(cuid())
  schoolId         String
  studentProfileId String
  classId          String
  sessionId        String
  outcome          EnrolmentOutcome @default(IN_PROGRESS)
  /// Set when the session is closed out and an outcome is applied.
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classroom      SchoolClass     @relation(fields: [classId], references: [id], onDelete: Restrict)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// A student sits in exactly one class per session.
  @@unique([studentProfileId, sessionId])
  @@index([classId, sessionId])
  @@index([schoolId, sessionId, outcome])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  /// e.g. MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY
  dayOfWeek String
  /// 24h local start time, e.g. "08:00"
  startTime String
  endTime   String
  subjectName String
  teacherName String?
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, dayOfWeek])
  @@index([schoolId])
}

// ── CBT practice (Computer-Based Testing) ─────────────────────────────────
// Real exam-style practice for students: a curated question bank per subject
// and class level, JAMB/WAEC-style runner (practice + timed exam modes), and
// stored attempts so progress is visible. See CBT-PRACTICE-PLAN.md.

model CbtSubject {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  /// jss1 | jss2 | jss3 | ss1 | ss2 | ss3
  classLevel  String
  /// junior | science | arts | commercial | general
  department  String         @default("general")
  questions   CbtQuestion[]
  attempts    CbtAttempt[]
  createdAt   DateTime       @default(now())

  @@index([classLevel])
}

model CbtQuestion {
  id           String     @id @default(cuid())
  subjectId    String
  topic        String
  /// 1 easy · 2 medium · 3 hard
  difficulty   Int        @default(2)
  stem         String
  /// JSON array of exactly 4 option strings
  options      Json
  /// 0-3 index into options
  correctIndex Int
  explanation  String
  /// curriculum | waec-style | neco-style | jamb-style
  source       String     @default("curriculum")
  /// draft | reviewed | published
  status       String     @default("published")
  createdAt    DateTime   @default(now())
  subject      CbtSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, status])
}

model CbtAttempt {
  id              String     @id @default(cuid())
  subjectId       String
  /// practice | exam
  mode            String
  total           Int
  correct         Int
  skipped         Int
  scorePct        Int
  durationSeconds Int
  studentName     String?
  studentEmail    String?
  /// JSON array of { questionId, selectedIndex|null }
  answers         Json
  createdAt       DateTime   @default(now())
  subject         CbtSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, createdAt])
}

/// An enquiry sent through the public contact form. It is stored so the school office
/// can answer it, and the visitor sees success only after this row is written.
model ContactEnquiry {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}
