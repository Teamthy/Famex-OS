model AdmissionDocument {
  id            String                @id @default(cuid())
  applicationId String
  type          AdmissionDocumentType
  fileName      String
  contentType   String
  sizeBytes     Int
  storageKey    String                @unique
  uploadedAt    DateTime              @default(now())
  /**
   * Malware scan verdict (C-006). PENDING until a scanner runs (or when the
   * scanner was unreachable — retried on next confirm), CLEAN when the
   * scanner cleared the bytes, INFECTED when it found a signature (document
   * is quarantined: never generate download links for it), SKIPPED when no
   * scanner is configured (dev/test or an explicitly accepted deployment).
   */
  scanStatus    String                @default("PENDING")
  scannedAt     DateTime?
  scanResult    String?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@index([applicationId])
}

