# Keep the Docker build context small and free of anything secret.
#
# Without this file the whole working tree is sent to the daemon — node_modules
# (hundreds of MB), .next, the full .git history, and any local .env. That is
# slow, and a stray .env in the context can end up baked into an image layer.

# Dependencies — reinstalled inside the image
node_modules
mobile/node_modules
.pnp
.pnp.js

# Build output — regenerated by the build stage
.next
out
build
dist
coverage
*.tsbuildinfo

# Version control and CI
.git
.github
.gitignore
.gitattributes

# Secrets — must never enter an image layer
.env
.env.*
!.env.example

# Local tooling / editor state
.vscode
.idea
.history
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Tests and fixtures — not needed at runtime
tests
vitest.config.ts

# The mobile app is built by EAS, not this image
mobile

# Development artifacts
*.ps1
*.zip
*.patch
_backups
.data
screens
deliverables
backups

# Docs — not needed at runtime
docs
*.md
!README.md

# Local logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
