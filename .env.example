# PostgreSQL / Neon
# Replace every placeholder before deployment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connect_timeout=30&connection_limit=1"

# Core auth / URL
AUTH_SECRET="replace-with-a-32-character-or-longer-secret"
NEXT_PUBLIC_SITE_URL="https://ykaycollege.com"

# Federated login for YK Virtual (YKAY-SSO).
# Lets YK Virtual verify a College session and sign the person in there with
# the same credentials. Leave UNSET to disable — /api/auth/verify-session then
# answers 503 rather than accepting traffic on an unconfigured integration.
#
# Must be a NEW 32+ character secret, identical to YK Virtual's
# COLLEGE_SSO_SECRET. Do NOT reuse AUTH_SECRET above: that is the JWT signing
# key and is already exposed to the middleware path.
# Generate one:  openssl rand -hex 32
COLLEGE_SSO_SECRET=""
EMAIL_FROM="Ykay College <noreply@ykaycollege.com>"
RESEND_API_KEY="re_replace_me"

# School profile
SCHOOL_SLUG="ykay-college"
SCHOOL_NAME="Ykay College & Leadership Academy"
SCHOOL_ADDRESS="Km 38, Lagos-Abeokuta Expressway, Sango Ota, Ogun State, Nigeria"
SCHOOL_PHONE="+2347015374411"
SCHOOL_EMAIL="info@ykaycollege.com"
SCHOOL_MOTTO="Excellence in Education"
# Set to Ykay's deployment domain so tenant resolution finds this school directly.
SCHOOL_CUSTOM_DOMAIN=""

# Initial admin bootstrap
INITIAL_ADMIN_EMAIL="admin@ykaycollege.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
INITIAL_ADMIN_NAME="Ykay College Administrator"

# Full seed (npm run db:seed) — creates all portal roles
# REQUIRED for the seed, min 12 chars. Left blank on purpose: this file is
# committed, so any value here is a publicly known password. Set it in your
# shell for the seed run only.
SEED_PASSWORD=""

# Super admin
SUPER_ADMIN_EMAIL="superadmin@ykaycollege.com"
SUPER_ADMIN_NAME="Platform Developer"
SUPER_ADMIN_PASSWORD=""

# Optional attendance/bootstrap portal users
# Leave passwords blank to let the bootstrap script generate secure random passwords.
BOOTSTRAP_TEACHER_EMAIL="grace.o@ykaycollege.com"
BOOTSTRAP_TEACHER_PASSWORD=""
BOOTSTRAP_STUDENT_EMAIL="student.demo@ykaycollege.com"
BOOTSTRAP_STUDENT_PASSWORD=""
BOOTSTRAP_PARENT_EMAIL="parent.demo@ykaycollege.com"
BOOTSTRAP_PARENT_PASSWORD=""

# Paystack — use test keys locally and live keys only in Production.
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
PAYSTACK_SECRET_KEY="sk_test_replace_me"

# Upstash Redis — REQUIRED in production for distributed rate limiting.
# Without it, security-critical limiters (login, password reset, payments,
# admissions) fail closed with 503. Set ALLOW_MEMORY_RATE_LIMITS="true" ONLY
# for an accepted single-instance deployment.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ALLOW_MEMORY_RATE_LIMITS=""

# Private S3-compatible document bucket (AWS S3 / Cloudflare R2).
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ADMISSIONS_PREFIX="admissions"
# Families upload admission documents straight from their browser to this bucket.
# The app adds exactly that storage origin to its Content-Security-Policy at request
# time, so changing these values needs no rebuild. Bucket CORS: docs/S3_ADMISSIONS_CORS.json.

# Malware scanning for admission documents (C-006). HTTP service that accepts
# raw file bytes and returns a verdict, e.g. clamav-rest in front of ClamAV:
#   { "Infected": false, "Result": "OK" }  (or { "status": "clean"|"infected" })
# When unset, uploads are recorded with scanStatus=SKIPPED — acceptable for
# dev/test, but production handling real parent documents should run one.
MALWARE_SCANNER_URL=""

# Staff QR attendance
SCHOOL_TIMEZONE=Africa/Lagos
STAFF_LATE_CUTOFF=08:00

# Set true only on demo/staging to show the corner demo badge
NEXT_PUBLIC_SHOW_DEMO_BADGE="false"

# Jobs / Vercel Cron — protects /api/jobs/dispatch-notifications (called every 5 min by vercel.json cron).
# On Vercel: set CRON_SECRET (Vercel injects it as the cron Bearer token) and set JOBS_SECRET to the same value.
# Elsewhere (external scheduler): set JOBS_SECRET and call with header `Authorization: Bearer <JOBS_SECRET>`.
JOBS_SECRET=""
CRON_SECRET=""

# E2E
# BASE_URL="http://127.0.0.1:3000"

# Multi-tenancy (Ykay platform)
# Set to your platform domain for subdomain-based tenant resolution (e.g. "ykay.app").
PLATFORM_BASE_DOMAIN=""

# ── Android APK distribution ──────────────────────────────
# The app is shared as a direct download, not via the Play Store.
#
# NEVER publish this URL. Share https://<site>/download instead — that page
# redirects via /download/apk, so the file can move hosts without breaking
# printed letters, QR codes or forwarded links.
#
# The repo is going PRIVATE after launch, so GitHub Release assets will NOT
# work: a private release asset 404s on its public URL and the API only hands
# back a short-lived signed redirect.
#
# Use Cloudflare R2: 10 GB free, ZERO egress fees, S3-compatible, custom domain.
#   wrangler r2 bucket create ykay-app
#   wrangler r2 object put ykay-app/ykay-college.apk --file ./ykay-college.apk
#   then R2 > bucket > Settings > Public access (or attach a custom domain)
#
# Must be NEXT_PUBLIC_ — the homepage CTA and hero are client components.
NEXT_PUBLIC_APK_URL="https://downloads.ykaycollege.com/ykay-college.apk"
# Optional: a secondary link if the primary host is ever blocked.
NEXT_PUBLIC_APK_FALLBACK_URL=""
# Optional: shown next to the button so parents on metered data know the cost.
NEXT_PUBLIC_APK_SIZE="89 MB"

# Extra browser origins allowed to call the API, comma-separated.
#
# Leave UNSET in production. NEXT_PUBLIC_SITE_URL is the only allowed origin
# by default, which is correct — but it means running the mobile app as a web
# build (npm run web, on localhost:8081) fails every request with the browser's
# unhelpful "Failed to fetch", because the response is blocked before your code
# sees it.
#
# Set this locally, or on a preview deployment, to permit those origins:
# CORS_EXTRA_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Error tracking (Sentry) ───────────────────────────────
# Optional but strongly recommended in production. Without it a 500 is
# invisible until somebody telephones the school.
#
# Both are the same DSN from your Sentry project. NEXT_PUBLIC_ is needed for
# browser errors (hydration crashes, a failed fetch on a parent's phone);
# the bare one covers the server and middleware.
#
# Leaving these blank is safe: the SDK loads and discards events. Monitoring
# must never be the reason the site is down.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── End-to-end tests ──────────────────────────────────────
# Must match the SEED_PASSWORD the test database was seeded with.
# Used by `npm run test:e2e:browser` and `npm run loadtest`.
E2E_PASSWORD=""

# C-011: platform (Ykay) SaaS self-serve school signup. Leave empty for a single-school
# (Ykay College) deployment — /signup and /api/platform/signup stay disabled.
ENABLE_PLATFORM_SIGNUP=""

# C-009: SMS via Termii (Nigerian provider) for parent notifications.
# Without these, SMS deliveries are marked "provider not configured" and
# skipped (never silently dropped); WhatsApp remains a stub.
TERMII_API_KEY=""
TERMII_SENDER_ID=""

# Privacy-friendly analytics (Plausible — no cookies, no consent banner).
# Leave empty to keep analytics completely off. When set, next.config.ts
# automatically allows plausible.io in the Content-Security-Policy.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
