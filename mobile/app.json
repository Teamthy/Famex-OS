{
  "expo": {
    "name": "Ykay College",
    "slug": "ykay-college",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ykaycollege",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ykaycollege.app",
      "associatedDomains": [
        "applinks:ykaycollege.com",
        "applinks:www.ykaycollege.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00072D"
      },
      "package": "com.ykaycollege.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ykaycollege.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "ykaycollege.com",
              "pathPrefix": "/verify/report"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ykay College to use the camera to scan staff attendance QR badges."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "flipper": false
          }
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f38053b7-646c-4e7a-ae26-df18e92c3cb9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f38053b7-646c-4e7a-ae26-df18e92c3cb9",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
