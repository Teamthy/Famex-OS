# ─────────────────────────────────────────────────────────────────────────────
# Famex OS — OCI single-VM deployment environment (/opt/famex/.env)
#
# bootstrap.sh generates the secrets marked GENERATED if this file is created
# by it; if you copy this template by hand, generate them yourself:
#   openssl rand -hex 32        (AUTH_SECRET, JOBS_SECRET)
#   openssl rand -hex 24        (POSTGRES_PASSWORD)
# NEVER commit the filled-in file. `chmod 600 .env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ingress: exactly one of "public" (Caddy 80/443) or "tunnel" (Cloudflare).
# Add ",monitoring" to also run Uptime Kuma on 127.0.0.1:3001.
COMPOSE_PROFILES=public

# ── Image: multi-arch GHCR image built by CI. Pin a release tag in
# production (IMAGE_TAG=1.2.3) rather than tracking main.
APP_IMAGE=ghcr.io/teamthy/famex-os
IMAGE_TAG=main

# ── Public address ───────────────────────────────────────────────────────────
SITE_DOMAIN=portal.example.com
ACME_EMAIL=admin@example.com
NEXT_PUBLIC_SITE_URL=https://portal.example.com
# Only for COMPOSE_PROFILES=tunnel (Cloudflare Zero Trust → Networks → Tunnels):
TUNNEL_TOKEN=

# ── Secrets (GENERATED by bootstrap.sh) ──────────────────────────────────────
POSTGRES_PASSWORD=
AUTH_SECRET=
JOBS_SECRET=

# ── Database (defaults match the compose `db` service) ───────────────────────
POSTGRES_DB=famex_os
POSTGRES_USER=famex
# DATABASE_URL=postgresql://famex:…@db:5432/famex_os   # override only if external

# ── Boot: seed the shared CBT question bank on every boot (idempotent) ──────
SEED_CBT_ON_BOOT=true

# ── Payments (test keys on staging, live keys in production) ─────────────────
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me

# ── Email (Resend free tier covers a small school; see docs/OCI-HOSTING.md) ──
RESEND_API_KEY=
EMAIL_FROM=Your School <noreply@example.com>

# ── SMS (optional — leave blank to keep SMS off) ─────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=

# ── Rate limiting: "true" accepts in-memory limits for this single-instance
# deployment. Set the Upstash pair instead if you ever run 2+ app instances.
ALLOW_MEMORY_RATE_LIMITS=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Admission documents: Cloudflare R2 (10 GB free, S3-compatible, supports
# the bucket CORS the browser direct-upload needs — docs/S3_ADMISSIONS_CORS.json).
# S3_ENDPOINT for R2 looks like https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADMISSIONS_PREFIX=admissions

# ── Malware scanning of admission documents (optional; unset = SKIPPED) ─────
MALWARE_SCANNER_URL=

# ── School profile: the one configured FIS school (never school switching) ──
SCHOOL_SLUG=famex-international-schools
SCHOOL_NAME=Famex International Schools
SCHOOL_ADDRESS=
SCHOOL_PHONE=+2347015374411
SCHOOL_EMAIL=
SCHOOL_MOTTO=Raising Role Models
SCHOOL_CUSTOM_DOMAIN=
SCHOOL_TIMEZONE=Africa/Lagos
STAFF_LATE_CUTOFF=08:00

# ── First admin: used ONCE by `node prisma/seed-admin.mjs` after first
# deploy. Remove INITIAL_ADMIN_PASSWORD afterwards (see docs/OCI-HOSTING.md §6).
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=School Administrator

# ── Error tracking (optional; server DSN) ────────────────────────────────────
SENTRY_DSN=

# ── Offsite backups (backup-offsite.sh; rclone remote named "offsite") ───────
OFFSITE_BUCKET=famex-backups
BACKUP_KEEP_DAYS=14
